<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- SCRUM-58 (spec 1.4): a 129+ char reply name registers in agt_ops
         (file_arrival.physical_filename is 512) then crashes the reader
         insert mid-flow on this column. Metadata-only widening in CRDB. -->
    <changeSet id="004-sbsr-resp-width-csx" author="dcre">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="sbsr_resp" columnName="response_file"/>
        </preConditions>
        <comment>128 to 512: match file_arrival.physical_filename; re-widening to the same type is a no-op.</comment>
        <modifyDataType tableName="sbsr_resp" columnName="response_file" newDataType="VARCHAR(512)"/>
        <modifySql dbms="postgresql, cockroachdb">
            <replace replace=" USING (response_file::VARCHAR(512))" with=""/>
        </modifySql>
    </changeSet>

</databaseChangeLog>
